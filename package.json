{
  "name": "ews-astrolink-api",
  "version": "0.1.0",
  "description": "EWS AstroLink API - clean architecture base",
  "type": "module",
  "main": "dist/src/entrypoints/api/main.js",
  "scripts": {
    "start": "node dist/src/entrypoints/api/main.js",
    "start:worker": "node dist/src/entrypoints/worker/main.js",
    "start:scheduler": "node dist/src/entrypoints/scheduler/main.js",
    "dev": "tsx watch --env-file-if-exists=.env src/entrypoints/api/main.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/entrypoints/worker/main.ts",
    "dev:scheduler": "tsx watch --env-file-if-exists=.env src/entrypoints/scheduler/main.ts",
    "typecheck": "tsc --noEmit",
    "lint:arch": "vitest run --project unit test/architecture",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:watch": "vitest --project unit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/entrypoints/migrate/main.ts",
    "db:migrate:prod": "node dist/src/entrypoints/migrate/main.js",
    "email:test": "tsx --env-file-if-exists=.env src/entrypoints/send-test-email/main.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "mysql2": "^3.24.4",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testcontainers/mysql": "^12.1.0",
    "@testcontainers/redis": "^12.1.0",
    "@types/node": "^22.20.3",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
