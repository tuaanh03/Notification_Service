        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    USERS ||--o{ SUBSCRIPTIONS     : \&quot;user_id\&quot;\n    USERS ||--o{ TOPIC_PREFERENCES : \&quot;user_id\&quot;\n    APPS  ||--o{ SUBSCRIPTIONS     : \&quot;app_id\&quot;\n    TOPICS ||--o{ TOPIC_PREFERENCES  : \&quot;topic_key\&quot;\n    TOPICS ||--o{ UNSUBSCRIBE_TOKENS : \&quot;topic_key (nullable)\&quot;\n    SUBSCRIPTIONS ||--o{ UNSUBSCRIBE_TOKENS : \&quot;subscription_id\&quot;\n\n    USERS {\n        uuid id PK \&quot;stub - xem chi tiet o ERD directory\&quot;\n    }\n\n    APPS {\n        uuid id PK \&quot;stub - xem chi tiet o ERD apps\&quot;\n    }\n\n    TOPICS {\n        string topic_key PK \&quot;stub - xem chi tiet o ERD topics\&quot;\n        uuid   app_id FK\n    }\n\n    SUBSCRIPTIONS {\n        uuid      id PK\n        uuid      user_id FK\n        uuid      app_id FK\n        enum      channel \&quot;email (chinh) | in_app\&quot;\n        string    value\n        enum      status \&quot;active|unsubscribed|invalid\&quot;\n        string    source\n        string    error\n        timestamp unsubscribed_at\n        string    unsubscribed_by\n        timestamp last_used\n    }\n\n    TOPIC_PREFERENCES {\n        uuid      user_id \&quot;PK, FK\&quot;\n        string    topic_key \&quot;PK, FK\&quot;\n        bool      opted_out\n        timestamp at\n        string    by\n    }\n\n    UNSUBSCRIBE_TOKENS {\n        string    token_hash PK\n        uuid      subscription_id FK\n        string    topic_key \&quot;FK, nullable\&quot;\n        timestamp expires_at\n        timestamp used_at\n    }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ET0ghFquDvt94dBwv_4U-1">
