        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    APPS ||--o{ USER_IDENTITIES     : \&quot;app_id (chi provenance)\&quot;\n    APPS ||--o{ USER_TAGS           : \&quot;app_id\&quot;\n    APPS ||--o{ USER_METRICS        : \&quot;app_id\&quot;\n    APPS ||--o{ USER_EVENTS         : \&quot;app_id\&quot;\n    APPS ||--o{ DIRECTORY_SYNC_RUNS : \&quot;app_id\&quot;\n\n    USERS ||--o{ USER_IDENTITIES : \&quot;user_id\&quot;\n    USERS ||--o{ USER_TAGS       : \&quot;user_id\&quot;\n    USERS ||--o{ USER_METRICS    : \&quot;user_id\&quot;\n    USERS ||--o{ USER_EVENTS     : \&quot;user_id\&quot;\n    USERS ||--o{ USER_MERGES     : \&quot;survivor_id\&quot;\n    USERS ||--o{ USER_MERGES     : \&quot;merged_id\&quot;\n\n    DIRECTORY_IMPORTS ||--o{ DIRECTORY_IMPORT_ROWS : \&quot;import_id\&quot;\n\n    APPS {\n        uuid   id PK\n        string slug UK\n        string namespace UK\n        string status\n    }\n\n    USERS {\n        uuid      id PK\n        string    name\n        enum      source \&quot;directory|import|self\&quot;\n        bool      identified\n        timestamp created_at\n        timestamp last_seen\n    }\n\n    USER_IDENTITIES {\n        uuid   id PK\n        uuid   user_id FK\n        enum   kind \&quot;external_id|email|phone\&quot;\n        string value \&quot;UK(kind,value)\&quot;\n        uuid   app_id \&quot;FK, nullable - chi de provenance\&quot;\n    }\n\n    USER_TAGS {\n        uuid      user_id FK\n        uuid      app_id FK\n        string    key\n        string    value\n        timestamp updated_at\n    }\n\n    USER_METRICS {\n        uuid      user_id FK\n        uuid      app_id FK\n        int       session_count\n        int       session_time\n        timestamp first_seen\n        timestamp last_seen\n    }\n\n    USER_EVENTS {\n        uuid      app_id FK\n        string    event_id UK\n        uuid      user_id FK\n        string    kind\n        jsonb     payload\n        timestamp at\n    }\n\n    USER_MERGES {\n        uuid      survivor_id FK\n        uuid      merged_id FK\n        string    matched_key\n        timestamp at\n        string    by\n    }\n\n    DIRECTORY_IMPORTS {\n        uuid   import_id PK\n        string status\n        jsonb  spec\n    }\n\n    DIRECTORY_IMPORT_ROWS {\n        uuid   import_id FK\n        int    line\n        jsonb  raw\n        enum   outcome \&quot;created|merged|conflict|error\&quot;\n        string reason\n    }\n\n    DIRECTORY_SYNC_RUNS {\n        uuid      app_id FK\n        enum      mode \&quot;pull|push\&quot;\n        timestamp synced_at\n        int       users\n        int       groups\n        string    snapshot_ref\n    }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="-k-psAoPmALQQEK1ILZ5-406">
