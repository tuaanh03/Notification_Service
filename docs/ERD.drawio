        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    ADMIN_ACCOUNTS ||--o{ APP_ADMINS      : \&quot;admin_account_id\&quot;\n    ADMIN_ACCOUNTS ||--o{ APP_APPROVALS   : \&quot;reviewer_id\&quot;\n    ADMIN_ACCOUNTS ||--o{ SEND_APPROVALS  : \&quot;author_id / reviewer_id\&quot;\n    ADMIN_ACCOUNTS ||--o{ NOTIFICATION_TRANSITIONS : \&quot;actor_id (khi actor_type=user)\&quot;\n    ADMIN_ACCOUNTS ||--o{ AUDIT_LOG       : \&quot;actor_id (khi actor_type=user)\&quot;\n    APPS ||--o{ APP_ADMINS : \&quot;app_id\&quot;\n\n    ADMIN_ACCOUNTS {\n        uuid   id PK\n        string name\n        string email UK\n        enum   role \&quot;super_admin|app_admin\&quot;\n        enum   status \&quot;active|disabled\&quot;\n        timestamp created_at\n    }\n\n    APP_ADMINS {\n        uuid admin_account_id \&quot;PK, FK\&quot;\n        uuid app_id \&quot;PK, FK\&quot;\n        enum scope \&quot;owner|reviewer|technical_contact\&quot;\n    }\n\n    APPS {\n        uuid id PK \&quot;stub - xem chi tiet o ERD apps\&quot;\n    }\n\n    APP_APPROVALS {\n        uuid app_id FK\n        uuid reviewer_id FK\n        jsonb decision\n    }\n\n    SEND_APPROVALS {\n        uuid notification_id FK\n        uuid author_id FK\n        uuid reviewer_id FK\n        string status\n    }\n\n    NOTIFICATION_TRANSITIONS {\n        uuid notification_id FK\n        enum actor_type \&quot;user|app|system\&quot;\n        uuid actor_id \&quot;FK -&gt; ADMIN_ACCOUNTS, chi khi actor_type=user\&quot;\n    }\n\n    AUDIT_LOG {\n        uuid   id PK\n        enum   actor_type \&quot;user|app|system\&quot;\n        uuid   actor_id \&quot;FK -&gt; ADMIN_ACCOUNTS, chi khi actor_type=user\&quot;\n        string action\n    }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="_AoJ9trZmCwtwpx0FZon-1">
