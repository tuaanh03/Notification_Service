<mjml><mj-head><mj-attributes><mj-all font-family="Arial, Helvetica, sans-serif"></mj-all></mj-attributes></mj-head><mj-body background-color="#f1f5f9"><mj-section background-color="#ffffff"><mj-column><mj-text font-size="22px" font-weight="700">Cảnh báo: {{ payload.vm_name }}</mj-text><mj-text>Xin chào {{ payload.name | default: "bạn" }}, máy <b>{{ payload.vm_name }}</b> vượt ngưỡng &amp; cần xử lý.<br/>Xem <a href="https://eon.vn/docs">tài liệu</a>.</mj-text><mj-button href="{{ payload.detail_url | default: 'https://eon.vn' }}" background-color="#2563eb">Xem chi tiết</mj-button><mj-image src="https://eon.vn/logo.png" alt="EON" width="120px" href="https://eon.vn"></mj-image><mj-divider border-color="#e2e8f0"></mj-divider><mj-spacer></mj-spacer></mj-column></mj-section><mj-section><mj-column><mj-text>Cột 1</mj-text></mj-column><mj-column><mj-text>Cột 2: {{ user.external_id }}</mj-text></mj-column></mj-section></mj-body></mjml>