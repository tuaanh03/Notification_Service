NODE_ENV=
PORT=3000
LOG_LEVEL=info
DATABASE_URL=
DB_POOL_SIZE=10
REDIS_URL=
HOST=0.0.0.0
WORKER_GROUPS=all
TRUST_PROXY=false
EMAIL_PROVIDER=mock
EMAIL_STUCK_SENDING_AFTER_MS=600000
# Gửi thật qua Microsoft Graph (EMAIL_PROVIDER=graph): cần EMAIL_SENDER_ADDRESS + 3 biến GRAPH_* bên dưới.
EMAIL_SENDER_ADDRESS=
EMAIL_MAX_PER_MINUTE=30
EMAIL_SEND_TIMEOUT_MS=15000

GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=
# AI soạn template (tuỳ chọn): endpoint …/chat/completions chuẩn tương thích OpenAI. AI_API_KEY trống = tắt AI.
# Có AI_API_KEY thì bắt buộc AI_API_URL + AI_MODEL.
AI_API_URL=
AI_API_KEY=
AI_MODEL=
# Đăng nhập console bằng Microsoft 365 (tuỳ chọn, ADR-0021): App registration RIÊNG, không dùng lại GRAPH_*.
# Điền đủ cả 4 hoặc để trống cả 4 (= tắt). M365_REDIRECT_URI = https://<console>/auth/callback/microsoft
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_REDIRECT_URI=
# Outgoing webhook (tuỳ chọn, ADR-0029): khoá chủ ký webhook, ≥ 32 ký tự — `openssl rand -base64 32`.
# Trống = webhook tắt. Đổi khoá = secret của MỌI URL webhook đổi theo, chỉ đổi khi bị lộ.
WEBHOOK_SIGNING_KEY=
# Chặn đăng nhập sai theo IP (tuỳ chọn, ADR-0039): khoá chung với console (console đặt CÙNG giá trị), ≥ 32 ký tự —
# `openssl rand -base64 32`. Trống = chỉ đếm sai theo email.
LOGIN_CLIENT_IP_SECRET=
