NODE_ENV=
PORT=3000
LOG_LEVEL=info
DATABASE_URL=
DB_POOL_SIZE=10
REDIS_URL=
HOST=0.0.0.0
WORKER_GROUPS=all
TRUST_PROXY=false
# Tạm thời cho /admin/* tới khi có đăng nhập admin. Sinh: openssl rand -hex 32
ADMIN_TOKEN=
EMAIL_PROVIDER=mock
EMAIL_STUCK_SENDING_AFTER_MS=600000
# Gửi thật qua Microsoft Graph (EMAIL_PROVIDER=graph): cần EMAIL_SENDER_ADDRESS + 3 biến GRAPH_* bên dưới.
EMAIL_SENDER_ADDRESS=
EMAIL_MAX_PER_MINUTE=30
EMAIL_SEND_TIMEOUT_MS=15000

GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=
MICROSOFT_REDIRECT_URI=


